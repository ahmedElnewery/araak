{
  "name": "charity-portal",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo run lint && node scripts/check-ui-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "node scripts/assert-dev-environment.mjs && vitest run --root tests/db --passWithNoTests",
    "e2e": "playwright test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --linked > packages/db/src/database.types.ts",
    "db:push": "node scripts/assert-dev-environment.mjs && supabase db push --linked",
    "db:check-env": "node scripts/assert-dev-environment.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
