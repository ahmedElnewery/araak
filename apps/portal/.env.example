# Real values live outside version control (.env.local or the secret manager).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, never NEXT_PUBLIC
SUPABASE_SECRET_KEY=
AUTH_THROTTLE_HMAC_KEY=
APP_ENV=development
# Tenants are <subdomain>.<this>: portal.localhost:3000 is the Araak organization, noor.localhost:3000 another one
PORTAL_BASE_DOMAIN=localhost:3000
# Number of trusted reverse-proxy hops. 0 = never trust X-Forwarded-Host.
TRUSTED_PROXY_HOPS=0
# Local/dev mail catcher or any SMTP URL (production stays disabled until GATE-OPS)
SMTP_URL=
