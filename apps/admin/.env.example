# Real values live outside version control (secret manager / .env.local). Never commit them.
APP_ENV=development
# 'development' | 'production'. Destructive tests only run when this is 'development'.
SUPABASE_ENV=development
# Supabase Cloud project URL, e.g. https://<project-ref>.supabase.co (Development vs Production use different projects)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_HOST=admin.localhost:3001
# Number of trusted reverse-proxy hops for forwarded host/IP handling (server-only).
TRUSTED_PROXY_HOPS=0
# Server-only HMAC key for auth throttling identifiers.
AUTH_THROTTLE_HMAC_KEY=
