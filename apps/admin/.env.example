# Real values live outside version control (.env.local or the secret manager).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, never NEXT_PUBLIC
SUPABASE_SECRET_KEY=
AUTH_THROTTLE_HMAC_KEY=
APP_ENV=development
ADMIN_HOST=admin.localhost:3001
# Tenant portal base domain: invitation and password-reset links point to <subdomain>.<this domain>
# (portal.localhost:3000 is the Araak organization, noor.localhost:3000 another one)
PORTAL_BASE_DOMAIN=localhost:3000
TRUSTED_PROXY_HOPS=0
SMTP_URL=
