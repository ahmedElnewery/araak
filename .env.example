# Root-level variables for scripts and DB/security tests (never commit real values; use .env.local or CI secrets).
SUPABASE_ENV=development
SUPABASE_DEV_PROJECT_REF=
# Optional but recommended: lets the guard prove tests never target Production.
SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/test-only secrets. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string of the DEVELOPMENT project (pooler URI), used by migration/RLS tests.
SUPABASE_DB_URL=
# Supabase CLI auth for `supabase link` / `db push` (personal access token).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
